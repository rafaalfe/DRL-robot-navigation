<launch>
  <!-- Argument definitions -->
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="extra_gazebo_args" default=""/>
  <arg name="gui" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="recording" default="false"/>
  <arg name="port" default="11345"/>
  <arg name="headless" default="false"/> <!-- Currently non-functional -->
  <arg name="debug" default="false"/>
  <arg name="physics" default="ode"/>
  <arg name="verbose" default="false"/>
  <arg name="world_name" default="TD3.world"/>
  <arg name="respawn_gazebo" default="true"/>
  <arg name="use_clock_frequency" default="false"/>
  <arg name="pub_clock_frequency" default="1000"/>

  <!-- Use simulation time -->
  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <!-- Command arguments based on condition -->
  <arg unless="$(arg paused)" name="command_arg1" value=""/>
  <arg     if="$(arg paused)" name="command_arg1" value="-u"/>
  <arg unless="$(arg recording)" name="command_arg2" value=""/>
  <arg     if="$(arg recording)" name="command_arg2" value="-r"/>
  <arg unless="$(arg verbose)" name="command_arg3" value=""/>
  <arg     if="$(arg verbose)" name="command_arg3" value="--verbose"/>
  <arg unless="$(arg debug)" name="script_type" value="gzserver"/>
  <arg     if="$(arg debug)" name="script_type" value="debug"/>

  <!-- Publish custom clock frequency if enabled -->
  <group if="$(arg use_clock_frequency)">
    <param name="gazebo/pub_clock_frequency" value="$(arg pub_clock_frequency)" />
  </group>

  <!-- Start Gazebo server -->
  <node name="gazebo" pkg="gazebo_ros" type="$(arg script_type)"
        respawn="$(arg respawn_gazebo)" output="screen"
        args="$(arg command_arg1) $(arg command_arg2) $(arg command_arg3) -e $(arg physics) $(arg extra_gazebo_args) $(arg world_name)">
    <env name="GAZEBO_MASTER_URI" value="http://localhost:$(arg port)"/>
  </node>

  <!-- Start Gazebo GUI if enabled -->
  <group if="$(arg gui)">
    <node name="gazebo_gui" pkg="gazebo_ros" type="gzclient" respawn="false" output="screen"/>
  </group>

  <!-- Load robot model in Gazebo -->
  <include file="$(find my_robot_description)/launch/rovid.gazebo.launch">
    <arg name="robot_name" value="rovid" />
    <arg name="robot_position" value="-x 0.0 -y 0.0 -z 0.01 -R 0 -P 0 -Y +0.0" />
  </include>

  <!-- Launch RViz -->
<group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find my_robot_description)/launch/rovid.rviz" />
  </group>
  
</launch>
